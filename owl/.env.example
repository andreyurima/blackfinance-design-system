# Copie este arquivo para .env (na mesma pasta) e cole os tokens.
# Bot User OAuth Token, em OAuth & Permissions (começa com xoxb-)
SLACK_BOT_TOKEN=
# App-Level Token com connections:write, em Basic Information (começa com xapp-)
SLACK_APP_TOKEN=
# Chave da API da Anthropic, em platform.claude.com > API Keys (começa com sk-ant-)
ANTHROPIC_API_KEY=
